<rdf:RDF xmlns="http://www.levelup-project.eu/ontologies#"
     xml:base="http://www.levelup-project.eu/ontologies"
     xmlns:owl2xml="http://www.w3.org/2006/12/owl2-xml#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:fma="http://LevelUp.eu#"
     xmlns:owl="http://www.w3.org/2002/07/owl#">
    <owl:Ontology rdf:about=""/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

     <owl:ObjectProperty rdf:about="#observedProperty">
        <rdfs:range rdf:resource="#ObservableProperty"/>
        <rdfs:domain rdf:resource="#Observation"/>
    </owl:ObjectProperty>

 <owl:ObjectProperty rdf:about="#madeBySensor">
        <rdfs:range rdf:resource="#Observation"/>
        <rdfs:domain rdf:resource="#DetachableSensor"/>
    </owl:ObjectProperty>

	
    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->
		
	
	<owl:DatatypeProperty rdf:about="#ObservationId">  
<rdf:type rdf:resource="&owl;InverseFunctionalProperty"/>   
        <rdfs:domain rdf:resource="#Observation"/>
        <rdfs:range rdf:resource="&xsd;string"/>
    </owl:DatatypeProperty> 
	


<owl:DatatypeProperty rdf:about="#dateTime">     
        <rdfs:domain rdf:resource="#Observation"/>
        <rdfs:range rdf:resource="&xsd;long"/>
    </owl:DatatypeProperty>
	

<owl:DatatypeProperty rdf:about="#deviceName">     
        <rdfs:domain rdf:resource="#Observation"/>
        <rdfs:range rdf:resource="&xsd;string"/>
    </owl:DatatypeProperty>

	<owl:DatatypeProperty rdf:about="#hasSimplifiedValue">     
        <rdfs:domain rdf:resource="#Observation"/>
        <rdfs:range rdf:resource="&xsd;string"/>
    </owl:DatatypeProperty>
	
	<owl:DatatypeProperty rdf:about="#index">     
        <rdfs:domain rdf:resource="#Observation"/>
        <rdfs:range rdf:resource="&xsd;int"/>
    </owl:DatatypeProperty>
       
<!-- Detachable Sensor -->

<owl:DatatypeProperty rdf:about="#Name">     
        <rdfs:domain rdf:resource="#DetachableSensor"/> 
        <rdfs:range rdf:resource="&xsd;string"/>
    </owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#Description">     
        <rdfs:domain rdf:resource="#DetachableSensor"/> 
        <rdfs:range rdf:resource="&xsd;string"/>
    </owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#ModelNumber">     
        <rdfs:domain rdf:resource="#DetachableSensor"/> 
        <rdfs:range rdf:resource="&xsd;string"/>
    </owl:DatatypeProperty>





    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

  
	
	 <owl:Class rdf:about="#Observation">
    </owl:Class>
	 <owl:Class rdf:about="#ObservableProperty">
    </owl:Class>
     
 <owl:Class rdf:about="#DetachableSensor">
    </owl:Class>

    <owl:Class rdf:about="&owl;Thing"/>
</rdf:RDF>



