# Vorlage - echte Werte in .env (wird nicht eingecheckt)

# Hugging-Face-Token, nur fuer gated Modelle noetig (das Standardmodell ist frei)
HF_TOKEN=

# Semantischer Mediator. Im docker-compose.yml stehen URL und Namensraum schon
# fest; diese Eintraege sind fuer den Start ausserhalb von Docker gedacht.
SEMANTIC_MEDIATOR_URL=http://127.0.0.1:8081
SEMANTIC_MEDIATOR_NAMESPACE=http://www.levelup-project.eu/ontologies
SEMANTIC_MEDIATOR_TOKEN=
